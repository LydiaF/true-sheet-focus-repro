+
+// RN Pressable-backed variant that avoids RNGH BaseButton -> TextInput focus quirks on iOS.
+export const PressableScaleNative = ({
+  enabled = true,
+  onPress,
+  onPressIn,
+  onPressOut,
+  style,
+  children,
+  disabled,
+  ...rest
+}: React.ComponentProps<typeof Pressable> & { enabled?: boolean }) => {
+  const { animationType, animationConfig, globalHandlers, config } =
+    usePressablesConfig();
+
+  const progress = useSharedValue(0);
+  const withAnimation = animationType === 'timing' ? withTiming : withSpring;
+
+  const rStyle = useAnimatedStyle(() => {
+    return {
+      transform: [
+        {
+          scale: interpolate(progress.value, [0, 1], [
+            config.baseScale,
+            config.minScale,
+          ]),
+        },
+      ],
+    };
+  }, [config.baseScale, config.minScale]);
+
+  const isDisabled = disabled ?? !enabled;
+
+  return (
+    <Pressable
+      {...rest}
+      disabled={isDisabled}
+      onPressIn={(e) => {
+        progress.value = withAnimation(1, animationConfig);
+        globalHandlers?.onPressIn?.({
+          isPressed: true,
+          isToggled: false,
+          isSelected: false,
+        });
+        onPressIn?.(e);
+      }}
+      onPressOut={(e) => {
+        progress.value = withAnimation(0, animationConfig);
+        globalHandlers?.onPressOut?.({
+          isPressed: false,
+          isToggled: false,
+          isSelected: false,
+        });
+        onPressOut?.(e);
+      }}
+      onPress={(e) => {
+        globalHandlers?.onPress?.({
+          isPressed: false,
+          isToggled: false,
+          isSelected: false,
+        });
+        onPress?.(e);
+      }}
+    >
+      <Animated.View style={[style ?? {}, rStyle]}>{children}</Animated.View>
+    </Pressable>
+  );
+};

